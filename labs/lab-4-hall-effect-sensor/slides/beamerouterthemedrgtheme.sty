\mode<presentation>

\usetikzlibrary{automata,positioning}

% Template : Frame Title
\defbeamertemplate*{frametitle}{drgtheme}[1][]
{ \vskip-0.1cm
  \begin{beamercolorbox}[wd=\paperwidth,ht=1.2cm]{frametitle} 
	  \begin{tikzpicture}
		  \useasboundingbox[fill=white](0,0) rectangle(\the\paperwidth,1.8);
		  \fill[uos-purple] (0,0) rectangle(\the\paperwidth,1.8);
		   \ifx\insertframesubtitle\@empty%
		      {\node(title)[anchor=west, white,font=\large,text width=0.9\paperwidth] at (0.2,0.6){\textbf{\MakeUppercase{\insertframetitle}}};}
		      \else%
		      {\node(title)[anchor= west, white,font=\large,text width=0.9\paperwidth] at (0.2,0.8){\textbf{\MakeUppercase{\insertframetitle}}};%
		       \node(subtitle)[white,font=\small, below=0.5ex of title.south west, anchor=west]{\insertframesubtitle};}%
		      \fi
	  \end{tikzpicture}
  \end{beamercolorbox}
}

% Template: Footer
\defbeamertemplate*{footline}{drgtheme}
{
	\ifnum \insertframenumber=1
	\leavevmode%
	\hbox{%
		\begin{beamercolorbox}[wd=\paperwidth,ht=6ex]{title in head/foot}%
			% empty environment to raise height
		\end{beamercolorbox}}%
		\vskip0pt%
	\else
		\leavevmode%
		\hbox{%
			\begin{beamercolorbox}[wd=0.85\paperwidth,ht=6ex]{title in head/foot}%
				\vspace{2ex}
				\begin{tikzpicture}
					\useasboundingbox[fill=uos-background](0,0) rectangle(\the\paperwidth,4ex);
					\draw[black!40] (3ex,4.5ex) -> (0.825\paperwidth,4.5ex);
					\ifx\theemail\@empty%
				     {\node[anchor=west,black!80] at (4ex,2ex){\insertframenumber\hspace{1ex}/\hspace{1ex}\therunninginstitute};}
				     \else%
				     {\node[anchor=west,black!80] at (4ex,2ex){\insertframenumber\hspace{1ex}/\hspace{1ex}\therunninginstitute};
				     \node[anchor=east, black!80, left] at (0.825\paperwidth,2ex){\texttt{\theemail}};}
				     \fi
				\end{tikzpicture}
			\end{beamercolorbox}}%
			\begin{beamercolorbox}[wd=0.15\paperwidth,ht=6ex]{title in head/foot}%
				\hfill\includegraphics[height=6ex]{./images/theme-assets/sheffield-dark.png}\hspace*{5ex}
				\vskip5pt
			\end{beamercolorbox}
		\vskip0pt%
	\fi
}
\setbeamerfont{footline}{size=\fontsize{6}{7}\selectfont}

\mode<all>