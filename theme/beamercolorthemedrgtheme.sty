\mode<presentation>

%Rosehips Colors
\definecolor{uos-purple}{HTML}{440099}
\definecolor{uos-dark}{HTML}{24125E}
\definecolor{uos-gray}{HTML}{A7A7A7}
\definecolor{uos-white}{HTML}{F8F8F9}
\definecolor{uos-black}{HTML}{131E29}
\definecolor{uos-background}{HTML}{FEFDE2}

\setbeamercolor*{palette primary}{
	bg=uos-background
	fg=uos-black
}

% Settings
\setbeamerfont{title}{size=\Huge, series=\mdseries}
\setbeamercolor{title page header}{fg=uos-purple}
\setbeamercolor*{author}{fg=uos-black}
\setbeamercolor*{date}{fg=uos-black!80}
\setbeamercolor*{frame numbering}{fg=uos-black!80}
\setbeamercolor{title in head/foot}{bg=uos-background}

\setbeamercolor*{block title}{fg=uos-white,bg=uos-black!40}
\setbeamercolor*{block body}{fg=uos-black,bg=uos-black!10}

\setbeamercolor*{background canvas}{bg=uos-background, fg=uos-white}

\setbeamercolor*{enumerate item}{fg=uos-black}
\setbeamercolor*{itemize item}{fg=uos-black}
\setbeamercolor*{itemize subitem}{fg=uos-black}

\setbeamertemplate{itemize subitem}[circle]%

\mode
<all>