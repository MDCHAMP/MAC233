\mode<presentation>

% Set defaults
\let \theemail\@empty
\let \thelocation\@empty
\let \therunninginstitute\@empty

% New commands in DRG theme
\providecommand{\email}[1]{\def \theemail {#1}}
\providecommand{\location}[1]{\def \thelocation {#1}}
\providecommand{\runninginstitute}[1]{\def \therunninginstitute {#1}}

% Requirements
\RequirePackage{tikz}

%  Set Up Date
\RequirePackage[UKenglish]{datetime2}
\DTMnewdatestyle{monthyear}{%
  \renewcommand*{\DTMdisplaydate}[4]{\DTMenglishmonthname{##2}, ##1}%
  \renewcommand*{\DTMDisplaydate}{\DTMdisplaydate}%
}
\DTMsetdatestyle{monthyear}

\setbeamertemplate{navigation symbols}{}

% Renew Make Title
\renewcommand{\maketitle}{
  \begingroup
  \setbeamertemplate{footline}{}
  \setbeamertemplate{background}[title]
  \setbeamercolor{background canvas}{bg=uos-white}
  \frame{\titlepage}
  \setbeamercolor{background canvas}{bg=}
  \endgroup
}

% Renew Title Page
\renewcommand{\titlepage}{
  \setbeamertemplate{background}[title]
  \usebeamertemplate*{title page}
}

% Settings
\useinnertheme{drgtheme}
\useoutertheme{drgtheme}
\usecolortheme{drgtheme}

\mode<all>