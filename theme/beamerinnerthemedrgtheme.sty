\mode<presentation>

\RequirePackage{etoolbox}
\RequirePackage{keyval}
\RequirePackage{calc}
\RequirePackage{pgfopts}
\RequirePackage{tikz}

\defbeamertemplate*{background}{drgdefault}[1][]{
	\begin{tikzpicture}
		\usebeamercolor{background canvas}
		\useasboundingbox (0,0) rectangle(\the\paperwidth,\the\paperheight);
		\fill[bg,opacity=1] (0,0) rectangle(\the\paperwidth,\the\paperheight);
	\end{tikzpicture}
}

\defbeamertemplate{background}{title}[1][]{
	\begin{tikzpicture}
		\usebeamercolor{background canvas}
		\useasboundingbox (0,0) rectangle(\the\paperwidth,\the\paperheight);
		\fill[bg,opacity=1] (0,0) rectangle(\the\paperwidth,\the\paperheight);
	\end{tikzpicture}
}

\defbeamertemplate{background}{standout}{
	\begin{tikzpicture}
		\usebeamercolor{background canvas}
		\useasboundingbox (0,0) rectangle(\the\paperwidth,\the\paperheight);
		\fill[bg,opacity=1] (0,0) rectangle(\the\paperwidth,\the\paperheight);
		\node (titlelogo) at (\paperwidth-2.75cm,1.25cm) {\includegraphics[width=4cm]{theme-assets/sheffield-light.png}};
	\end{tikzpicture}
}

% Title page
\defbeamertemplate*{title page}{drgtheme}[1][]
{
	\begin{beamercolorbox}[wd=\paperwidth,leftskip=0.05\paperwidth,sep=8pt,#1]{title page header}
		\usebeamerfont{title}\inserttitle\par%
	\end{beamercolorbox}%

	\vskip0.7cm%
	\begin{beamercolorbox}[wd=\paperwidth,leftskip=0.074\paperwidth,#1]{author}
		\usebeamerfont{author}\hspace{-0.35em}\insertauthor%
	\end{beamercolorbox}

	\vskip0.35cm%
	\begin{beamercolorbox}[wd=\paperwidth,leftskip=0.074\paperwidth,#1]{author}
		\usebeamerfont{author}\hspace{-0.35em}\insertinstitute%
	\end{beamercolorbox}

	
	\ifx\thelocation\@empty\else
		\vskip0.35cm%
		\begin{beamercolorbox}[wd=\paperwidth,leftskip=0.074\paperwidth,#1]{author}
			\usebeamerfont{author}\hspace{-0.35em}\thelocation%
		\end{beamercolorbox}
	\fi

	\vskip0.35cm%
	\begin{beamercolorbox}[wd=\paperwidth,leftskip=0.074\paperwidth,#1]{date}
		\usebeamerfont{author}\hspace{0.1em}\insertdate%
	\end{beamercolorbox}

	\vfill
	\begin{beamercolorbox}[wd=0.3\paperwidth, leftskip=0.6\paperwidth]{sheffield logo}
		\includegraphics[width=0.3\paperwidth]{theme-assets/sheffield-violet.png}
		\vspace{-3em}
	\end{beamercolorbox}

}
\setbeamertemplate{title page}[drgtheme]

\define@key{beamerframe}{c}[true]{% centered
  \beamer@frametopskip=0pt plus 1fill\relax%
  \beamer@framebottomskip=0pt plus 1fill\relax%
  \beamer@frametopskipautobreak=0pt plus .4\paperheight\relax%
  \beamer@framebottomskipautobreak=0pt plus .6\paperheight\relax%
  \def\beamer@initfirstlineunskip{}%
}

\newbool{drgtheme@standout}
\define@key{beamerframe}{standout}[true]{%
  \booltrue{drgtheme@standout}
  \begingroup
    \setbeamertemplate{background}[standout]
    \setkeys{beamerframe}{c}
    \setkeys{beamerframe}{noframenumbering}
    \setbeamertemplate{footline}{}
    \setbeamercolor{background canvas}{bg=uos-purple}
    \setbeamercolor{local structure}{fg=black!0}
    
    \centering
    \setbeamercolor{standout text}{fg=white}
    \usebeamercolor[fg]{standout text}
    \setbeamerfont*{standout}{size=\Large,series=\bfseries}
    \usebeamerfont{standout}
}
\apptocmd{\beamer@reseteecodes}{%
    \ifbool{drgtheme@standout}{
      \endgroup
      \boolfalse{drgtheme@standout}
    }{}
  }{}{}

\mode<all>